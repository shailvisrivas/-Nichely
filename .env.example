# Copy this file to .env and fill in real values. Never commit .env.

# LLM provider (Topic Scout reasoning + Content Strategist generation)
GEMINI_API_KEY=

# News source
NEWS_API_KEY=

# Image generation
IMAGE_GEN_API_KEY=

# Public image hosting (if using Cloudinary)
CLOUDINARY_URL=

# Instagram Platform (from Meta Developer App Dashboard, after
# completing Business Login for Instagram setup)
IG_APP_ID=
IG_APP_SECRET=
IG_ACCESS_TOKEN=
IG_USER_ID=

# Mode flag: start in mock, switch to "live" once Instagram is fully wired up (Phase 9)
PUBLISH_MODE=mock

# Local database path
DATABASE_URL=sqlite:///./nichely.db
